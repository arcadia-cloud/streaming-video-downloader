+        try:
+            on_log(message, level)
+        except TypeError:
+            try:
+                on_log(message)
+            except Exception:  # noqa: BLE001
+                pass
+        except Exception:  # noqa: BLE001 - 日志不能影响下载
+            pass
+
+    return emit
